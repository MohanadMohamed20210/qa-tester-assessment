    {
      "name": "Send Gift (with audience bonus)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const isLoginRequest = pm.request.url.toString().includes('/api/auth/login');\r",
              "\r",
              "if (!isLoginRequest) {\r",
              "    const token = pm.environment.get('auth_token');\r",
              "\r",
              "    if (token) {\r",
              "        pm.request.headers.upsert({\r",
              "            key: 'Authorization',\r",
              "            value: `Bearer ${token}`\r",
              "        });\r",
              "    }\r",
              "}\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Send gift returns 200 OK or 201 Created', function () {\r",
              "    pm.expect([200, 201]).to.include(pm.response.code);\r",
              "});\r",
              "\r",
              "pm.test('Response body is JSON', function () {\r",
              "    pm.response.to.be.json;\r",
              "});\r",
              "\r",
              "const sendGiftSchema = {\r",
              "    type: 'object',\r",
              "    required: [\r",
              "        'transaction_id',\r",
              "        'room_id',\r",
              "        'gift_id',\r",
              "        'quantity',\r",
              "        'coins_charged',\r",
              "        'remaining_balance',\r",
              "        'winners'\r",
              "    ],\r",
              "    properties: {\r",
              "        transaction_id: { type: ['string', 'number'] },\r",
              "        room_id: { type: ['number', 'string'] },\r",
              "        gift_id: { type: ['number', 'string'] },\r",
              "        quantity: { type: 'number' },\r",
              "        coins_charged: { type: 'number' },\r",
              "        remaining_balance: { type: 'number' },\r",
              "        winners: {\r",
              "            type: 'array',\r",
              "            items: {\r",
              "                type: 'object'\r",
              "            }\r",
              "        }\r",
              "    }\r",
              "};\r",
              "\r",
              "pm.test('Send gift response matches expected schema', function () {\r",
              "    pm.response.to.have.jsonSchema(sendGiftSchema);\r",
              "});\r",
              "\r",
              "const json = pm.response.json();\r",
              "\r",
              "const quantity = Number(pm.environment.get('quantity'));\r",
              "const giftCoinPrice = Number(pm.environment.get('gift_coin_price'));\r",
              "const winnersCount = Number(pm.environment.get('winners_count'));\r",
              "const walletBefore = Number(pm.environment.get('wallet_balance_before'));\r",
              "\r",
              "const expectedChargedCoins = quantity * giftCoinPrice;\r",
              "const expectedRemainingBalance = walletBefore - expectedChargedCoins;\r",
              "\r",
              "pm.environment.set('expected_charged_coins', expectedChargedCoins);\r",
              "pm.environment.set('remaining_balance', json.remaining_balance);\r",
              "pm.environment.set('last_transaction_id', json.transaction_id);\r",
              "\r",
              "pm.test('Response room_id matches environment room_id', function () {\r",
              "    pm.expect(String(json.room_id)).to.eql(String(pm.environment.get('room_id')));\r",
              "});\r",
              "\r",
              "pm.test('Response gift_id matches environment gift_id', function () {\r",
              "    pm.expect(String(json.gift_id)).to.eql(String(pm.environment.get('gift_id')));\r",
              "});\r",
              "\r",
              "pm.test('Response quantity matches environment quantity', function () {\r",
              "    pm.expect(Number(json.quantity)).to.eql(quantity);\r",
              "});\r",
              "\r",
              "pm.test('Charged coins equals quantity multiplied by gift coin price', function () {\r",
              "    pm.expect(Number(json.coins_charged)).to.eql(expectedChargedCoins);\r",
              "});\r",
              "\r",
              "pm.test('Remaining balance equals wallet balance before request minus charged coins', function () {\r",
              "    pm.expect(Number(json.remaining_balance)).to.eql(expectedRemainingBalance);\r",
              "});\r",
              "\r",
              "pm.test('Winners array length matches winners_count', function () {\r",
              "    pm.expect(json.winners.length).to.eql(winnersCount);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
