        {
          "name": "Send Gift - Invalid Quantity",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Invalid quantity returns 422 Unprocessable Entity', function () {\r",
                  "    pm.response.to.have.status(422);\r",
                  "});\r",
                  "\r",
                  "pm.test('Response body is JSON', function () {\r",
                  "    pm.response.to.be.json;\r",
                  "});\r",
                  "\r",
                  "const errorSchema = {\r",
                  "    type: 'object',\r",
                  "    required: ['message', 'errors'],\r",
                  "    properties: {\r",
                  "        message: {\r",
                  "            type: 'string'\r",
                  "        },\r",
                  "        errors: {\r",
                  "            type: 'object'\r",
                  "        }\r",
                  "    }\r",
                  "};\r",
                  "\r",
                  "pm.test('Validation error response matches expected schema', function () {\r",
                  "    pm.response.to.have.jsonSchema(errorSchema);\r",
                  "});\r",
                  "\r",
                  "const json = pm.response.json();\r",
                  "\r",
                  "pm.test('Quantity validation error is returned', function () {\r",
                  "    pm.expect(json.errors.quantity, 'quantity error').to.exist;\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const isLoginRequest = pm.request.url.toString().includes('/api/auth/login');\r",
                  "\r",
                  "if (!isLoginRequest) {\r",
                  "    const token = pm.environment.get('auth_token');\r",
                  "\r",
                  "    if (token) {\r",
                  "        pm.request.headers.upsert({\r",
                  "            key: 'Authorization',\r",
                  "            value: `Bearer ${token}`\r",
                  "        });\r",
                  "    }\r",
                  "}\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"room_id\": {{room_id}},\r\n  \"gift_id\": {{gift_id}},\r\n  \"quantity\": 0,\r\n  \"winners_count\": {{winners_count}},\r\n  \"idempotency_key\": \"{{$guid}}\"\r\n}",
