      "name": "Login (Sanctum)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const isLoginRequest = pm.request.url.toString().includes('/api/auth/login');\r",
              "\r",
              "if (!isLoginRequest) {\r",
              "    const token = pm.environment.get('auth_token');\r",
              "\r",
              "    if (token) {\r",
              "        pm.request.headers.upsert({\r",
              "            key: 'Authorization',\r",
              "            value: `Bearer ${token}`\r",
              "        });\r",
              "    }\r",
              "}\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login returns 200 OK', function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test('Response body is JSON', function () {\r",
              "    pm.response.to.be.json;\r",
              "});\r",
              "\r",
              "const loginSchema = {\r",
              "    type: 'object',\r",
              "    required: ['token', 'user'],\r",
              "    properties: {\r",
              "        token: {\r",
              "            type: 'string',\r",
              "            minLength: 10\r",
              "        },\r",
              "        user: {\r",
              "            type: 'object',\r",
              "            required: ['id', 'email', 'wallet_balance'],\r",
              "            properties: {\r",
              "                id: {\r",
              "                    type: ['number', 'string']\r",
              "                },\r",
              "                email: {\r",
              "                    type: 'string'\r",
              "                },\r",
              "                wallet_balance: {\r",
              "                    type: 'number'\r",
              "                }\r",
              "            }\r",
              "        }\r",
              "    }\r",
              "};\r",
              "\r",
              "pm.test('Login response matches expected schema', function () {\r",
              "    pm.response.to.have.jsonSchema(loginSchema);\r",
              "});\r",
              "\r",
              "const json = pm.response.json();\r",
              "\r",
              "pm.test('Token is returned and not empty', function () {\r",
              "    pm.expect(json.token).to.be.a('string').and.not.empty;\r",
              "});\r",
              "\r",
              "pm.test('Logged in email matches environment email', function () {\r",
              "    pm.expect(json.user.email).to.eql(pm.environment.get('email'));\r",
              "});\r",
              "\r",
              "pm.environment.set('auth_token', json.token);\r",
              "pm.environment.set('user_id', json.user.id);\r",
              "pm.environment.set('wallet_balance_before', json.user.wallet_balance);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
